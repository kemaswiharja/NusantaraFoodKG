     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:nus="http://www.semanticweb.org/nusantara#">

    <owl:Ontology rdf:about="http://www.semanticweb.org/nusantara">
        <rdfs:label>Ontologi Masakan dan Minuman Nusantara</rdfs:label>
        <rdfs:comment>Ontologi contoh untuk Bab 11 (struktur OD101) dan Bab 12 (rules SWRL) buku ajar Semantic Web. Nusantara mencakup Indonesia, Malaysia, Singapura, dan Brunei Darussalam.</rdfs:comment>
    </owl:Ontology>

