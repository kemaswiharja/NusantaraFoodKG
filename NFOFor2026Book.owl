    <owl:ObjectProperty rdf:about="#berasalDari"><rdfs:label>berasalDari</rdfs:label><rdfs:range rdf:resource="#Daerah_di_Nusantara"/></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#terbuatDari"><rdfs:label>terbuatDari</rdfs:label></owl:ObjectProperty>

    <!-- Object property tambahan untuk Bab 12 -->
    <owl:ObjectProperty rdf:about="#cocokDisantapSetelah"><rdfs:label>cocokDisantapSetelah (rule 12.4.2)</rdfs:label></owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="#seasalDengan"><rdfs:label>seasalDengan (rule 12.4.2)</rdfs:label></owl:ObjectProperty>

    <!-- ============================================================ -->
    <!-- BAB 11: DATA PROPERTIES                                      -->
    <!-- ============================================================ -->

    <owl:DatatypeProperty rdf:about="#punyaKomposisiKalsium"><rdfs:label>punyaKomposisiKalsium</rdfs:label><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#punyaKomposisiKarbohidrat"><rdfs:label>punyaKomposisiKarbohidrat</rdfs:label><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#punyaKomposisiLemak"><rdfs:label>punyaKomposisiLemak</rdfs:label><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#punyaKomposisiProtein"><rdfs:label>punyaKomposisiProtein</rdfs:label><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#punyaKomposisiSerat"><rdfs:label>punyaKomposisiSerat</rdfs:label><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#punyaKomposisiEnergi"><rdfs:label>punyaKomposisiEnergi</rdfs:label><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/></owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#punyaKomposisiAir"><rdfs:label>punyaKomposisiAir</rdfs:label><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/></owl:DatatypeProperty>

