    <owl:NamedIndividual rdf:about="#asam"><rdf:type rdf:resource="#Rasa"/><rdfs:label>asam</rdfs:label></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#asin"><rdf:type rdf:resource="#Rasa"/><rdfs:label>asin</rdfs:label></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#gurih"><rdf:type rdf:resource="#Rasa"/><rdfs:label>gurih</rdfs:label></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#tawar"><rdf:type rdf:resource="#Rasa"/><rdfs:label>tawar</rdfs:label></owl:NamedIndividual>

    <!-- ============================================================ -->
    <!-- INDIVIDUAL: DAERAH                                           -->
    <!-- ============================================================ -->
    <owl:NamedIndividual rdf:about="#sunda"><rdf:type rdf:resource="#Daerah_di_Nusantara"/><rdfs:label>sunda</rdfs:label></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#minang"><rdf:type rdf:resource="#Daerah_di_Nusantara"/><rdfs:label>minang</rdfs:label></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#papua"><rdf:type rdf:resource="#Daerah_di_Nusantara"/><rdfs:label>papua</rdfs:label></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#sumatera_utara"><rdf:type rdf:resource="#Daerah_di_Nusantara"/><rdfs:label>sumatera utara</rdfs:label></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#betawi"><rdf:type rdf:resource="#Daerah_di_Nusantara"/><rdfs:label>betawi</rdfs:label></owl:NamedIndividual>

    <!-- ============================================================ -->
    <!-- INDIVIDUAL: BAHAN (IKAN MENTAH)                              -->
    <!-- ============================================================ -->
    <owl:NamedIndividual rdf:about="#ikan_tuna"><rdf:type rdf:resource="#Ikan_mentah"/><rdfs:label>ikan tuna</rdfs:label></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#ikan_kembung"><rdf:type rdf:resource="#Ikan_mentah"/><rdfs:label>ikan kembung</rdfs:label></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#ikan_teri"><rdf:type rdf:resource="#Ikan_mentah"/><rdfs:label>ikan teri</rdfs:label></owl:NamedIndividual>

    <!-- ============================================================ -->
    <!-- INDIVIDUAL: MASAKAN & MINUMAN (dengan data untuk uji rule)   -->
    <!-- ============================================================ -->

    <!-- Pempek: terbuat dari ikan (uji rule 12.4.1 Masakan_Laut) -->
    <owl:NamedIndividual rdf:about="#pempek">
        <rdf:type rdf:resource="#Ikan_masakan"/>
        <rdfs:label>pempek</rdfs:label>
        <terbuatDari rdf:resource="#ikan_tuna"/>
        <berasalDari rdf:resource="#sumatera_utara"/>
        <punyaRasa rdf:resource="#gurih"/>
        <punyaKomposisiLemak rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">8</punyaKomposisiLemak>
        <punyaKomposisiKarbohidrat rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">30</punyaKomposisiKarbohidrat>
        <punyaKomposisiProtein rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">12</punyaKomposisiProtein>
    </owl:NamedIndividual>

    <!-- Rendang: berlemak tinggi, dari minang (uji rule 12.3 & 12.4.3) -->
    <owl:NamedIndividual rdf:about="#rendang">
        <rdf:type rdf:resource="#Daging_unggas_masakan"/>
        <rdfs:label>rendang</rdfs:label>
        <berasalDari rdf:resource="#minang"/>
        <punyaRasa rdf:resource="#pedas"/>
        <punyaKomposisiLemak rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">45</punyaKomposisiLemak>
        <punyaKomposisiKarbohidrat rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10</punyaKomposisiKarbohidrat>
        <punyaKomposisiProtein rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">28</punyaKomposisiProtein>
    </owl:NamedIndividual>

    <!-- Karedok: masakan sunda pedas (uji rule 12.4.4) -->
    <owl:NamedIndividual rdf:about="#karedok">
        <rdf:type rdf:resource="#Sayuran_masakan"/>
        <rdfs:label>karedok</rdfs:label>
        <berasalDari rdf:resource="#sunda"/>
        <punyaRasa rdf:resource="#pedas"/>
        <punyaKomposisiLemak rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">6</punyaKomposisiLemak>
    </owl:NamedIndividual>

    <!-- Sup konro: berminyak, sehat rendah lemak? (uji 12.4.2, 12.4.3) -->
    <owl:NamedIndividual rdf:about="#sup_konro">
        <rdf:type rdf:resource="#Daging_unggas_masakan"/>
        <rdfs:label>sup konro</rdfs:label>
        <berasalDari rdf:resource="#sunda"/>
        <punyaRasa rdf:resource="#gurih"/>
        <punyaKomposisiLemak rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">22</punyaKomposisiLemak>
    </owl:NamedIndividual>

    <!-- Es cendol: minuman asam segar (uji rule 12.4.2 cocokDisantapSetelah) -->
    <owl:NamedIndividual rdf:about="#es_cendol">
        <rdf:type rdf:resource="#Minuman"/>
        <rdfs:label>es cendol</rdfs:label>
        <berasalDari rdf:resource="#sunda"/>
        <punyaRasa rdf:resource="#asam"/>
    </owl:NamedIndividual>

    <!-- Sambal matah: sambal (untuk contoh, diberi asal sumatera_utara untuk uji 12.4.4) -->
    <owl:NamedIndividual rdf:about="#sambal_lado">
        <rdf:type rdf:resource="#Sambal"/>
        <rdfs:label>sambal lado</rdfs:label>
        <berasalDari rdf:resource="#sumatera_utara"/>
        <punyaRasa rdf:resource="#pedas"/>
    </owl:NamedIndividual>

    <!-- Data cacat sengaja: lemak negatif (uji rule validasi 12.4.5) -->
    <owl:NamedIndividual rdf:about="#data_uji_cacat">
        <rdf:type rdf:resource="#Sayuran_masakan"/>
        <rdfs:label>data uji cacat</rdfs:label>
        <punyaKomposisiLemak rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-3</punyaKomposisiLemak>
    </owl:NamedIndividual>

    <!-- ============================================================ -->
    <!-- BAB 12: RULES SWRL                                           -->
    <!-- Ditulis dalam SWRL/RDF. Protege akan menampilkannya di       -->
    <!-- SWRLTab. Setiap Imp = satu rule.                             -->
    <!-- ============================================================ -->

    <!-- RULE 12.3 : Masakan_Berlemak_Tinggi -->
    <swrl:Imp rdf:about="#Rule_12_3_BerlemakTinggi">
        <rdfs:label>12.3 Masakan Berlemak Tinggi</rdfs:label>
        <swrl:body>
            <swrl:AtomList>
                <rdf:first>
                    <swrl:ClassAtom>
                        <swrl:classPredicate rdf:resource="#Serelia_masakan"/>
                        <swrl:argument1 rdf:resource="urn:swrl#m"/>
                    </swrl:ClassAtom>
                </rdf:first>
                <rdf:rest>
                    <swrl:AtomList>
                        <rdf:first>
                            <swrl:DatavaluedPropertyAtom>
                                <swrl:propertyPredicate rdf:resource="#punyaKomposisiLemak"/>
                                <swrl:argument1 rdf:resource="urn:swrl#m"/>
                                <swrl:argument2 rdf:resource="urn:swrl#lemak"/>
                            </swrl:DatavaluedPropertyAtom>
                        </rdf:first>
                        <rdf:rest>
                            <swrl:AtomList>
                                <rdf:first>
                                    <swrl:BuiltinAtom>
                                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThan"/>
                                        <swrl:arguments>
                                            <rdf:List>
                                                <rdf:first rdf:resource="urn:swrl#lemak"/>
                                                <rdf:rest>
                                                    <rdf:List>
                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">20</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:List>
                                                </rdf:rest>
                                            </rdf:List>
                                        </swrl:arguments>
                                    </swrl:BuiltinAtom>
                                </rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </swrl:AtomList>
                        </rdf:rest>
                    </swrl:AtomList>
                </rdf:rest>
            </swrl:AtomList>
        </swrl:body>
        <swrl:head>
            <swrl:AtomList>
                <rdf:first>
                    <swrl:ClassAtom>
                        <swrl:classPredicate rdf:resource="#Masakan_Berlemak_Tinggi"/>
                        <swrl:argument1 rdf:resource="urn:swrl#m"/>
                    </swrl:ClassAtom>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </swrl:AtomList>
        </swrl:head>
    </swrl:Imp>

    <!-- RULE 12.4.1a : Masakan_Laut -->
    <swrl:Imp rdf:about="#Rule_12_4_1a_MasakanLaut">
        <rdfs:label>12.4.1 Masakan Laut</rdfs:label>
        <swrl:body>
            <swrl:AtomList>
                <rdf:first>
                    <swrl:IndividualPropertyAtom>
                        <swrl:propertyPredicate rdf:resource="#terbuatDari"/>
                        <swrl:argument1 rdf:resource="urn:swrl#masakan"/>
                        <swrl:argument2 rdf:resource="urn:swrl#bahan"/>
                    </swrl:IndividualPropertyAtom>
                </rdf:first>
                <rdf:rest>
                    <swrl:AtomList>
                        <rdf:first>
                            <swrl:ClassAtom>
                                <swrl:classPredicate rdf:resource="#Ikan_mentah"/>
                                <swrl:argument1 rdf:resource="urn:swrl#bahan"/>
                            </swrl:ClassAtom>
                        </rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                    </swrl:AtomList>
                </rdf:rest>
            </swrl:AtomList>
        </swrl:body>
        <swrl:head>
            <swrl:AtomList>
                <rdf:first>
                    <swrl:ClassAtom>
                        <swrl:classPredicate rdf:resource="#Masakan_Laut"/>
                        <swrl:argument1 rdf:resource="urn:swrl#masakan"/>
                    </swrl:ClassAtom>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </swrl:AtomList>
        </swrl:head>
    </swrl:Imp>

    <!-- RULE 12.4.1b : Masakan_Pedas -->
    <swrl:Imp rdf:about="#Rule_12_4_1b_MasakanPedas">
        <rdfs:label>12.4.1 Masakan Pedas</rdfs:label>
        <swrl:body>
            <swrl:AtomList>
                <rdf:first>
                    <swrl:IndividualPropertyAtom>
                        <swrl:propertyPredicate rdf:resource="#punyaRasa"/>
                        <swrl:argument1 rdf:resource="urn:swrl#masakan"/>
                        <swrl:argument2 rdf:resource="#pedas"/>
                    </swrl:IndividualPropertyAtom>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </swrl:AtomList>
        </swrl:body>
        <swrl:head>
            <swrl:AtomList>
                <rdf:first>
                    <swrl:ClassAtom>
                        <swrl:classPredicate rdf:resource="#Masakan_Pedas"/>
                        <swrl:argument1 rdf:resource="urn:swrl#masakan"/>
                    </swrl:ClassAtom>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </swrl:AtomList>
        </swrl:head>
    </swrl:Imp>

    <!-- RULE 12.4.2b : seasalDengan (property-derivation, pola segitiga) -->
    <swrl:Imp rdf:about="#Rule_12_4_2b_Seasal">
        <rdfs:label>12.4.2 seasalDengan</rdfs:label>
        <swrl:body>
            <swrl:AtomList>
                <rdf:first>
                    <swrl:IndividualPropertyAtom>
                        <swrl:propertyPredicate rdf:resource="#berasalDari"/>
                        <swrl:argument1 rdf:resource="urn:swrl#masakan1"/>
                        <swrl:argument2 rdf:resource="urn:swrl#daerah"/>
                    </swrl:IndividualPropertyAtom>
                </rdf:first>
                <rdf:rest>
                    <swrl:AtomList>
                        <rdf:first>
                            <swrl:IndividualPropertyAtom>
                                <swrl:propertyPredicate rdf:resource="#berasalDari"/>
                                <swrl:argument1 rdf:resource="urn:swrl#masakan2"/>
                                <swrl:argument2 rdf:resource="urn:swrl#daerah"/>
                            </swrl:IndividualPropertyAtom>
                        </rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                    </swrl:AtomList>
                </rdf:rest>
            </swrl:AtomList>
        </swrl:body>
        <swrl:head>
            <swrl:AtomList>
                <rdf:first>
                    <swrl:IndividualPropertyAtom>
                        <swrl:propertyPredicate rdf:resource="#seasalDengan"/>
                        <swrl:argument1 rdf:resource="urn:swrl#masakan1"/>
                        <swrl:argument2 rdf:resource="urn:swrl#masakan2"/>
                    </swrl:IndividualPropertyAtom>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </swrl:AtomList>
        </swrl:head>
    </swrl:Imp>

    <!-- RULE 12.4.3a : Masakan_Berisiko (lemak > 20) -->
    <swrl:Imp rdf:about="#Rule_12_4_3a_Berisiko">
        <rdfs:label>12.4.3 Masakan Berisiko</rdfs:label>
        <swrl:body>
            <swrl:AtomList>
                <rdf:first>
                    <swrl:DatavaluedPropertyAtom>
                        <swrl:propertyPredicate rdf:resource="#punyaKomposisiLemak"/>
                        <swrl:argument1 rdf:resource="urn:swrl#masakan"/>
                        <swrl:argument2 rdf:resource="urn:swrl#lemak"/>
                    </swrl:DatavaluedPropertyAtom>
                </rdf:first>
                <rdf:rest>
                    <swrl:AtomList>
                        <rdf:first>
                            <swrl:BuiltinAtom>
                                <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThan"/>
                                <swrl:arguments>
                                    <rdf:List>
                                        <rdf:first rdf:resource="urn:swrl#lemak"/>
                                        <rdf:rest>
                                            <rdf:List>
                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">20</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:List>
                                        </rdf:rest>
                                    </rdf:List>
                                </swrl:arguments>
                            </swrl:BuiltinAtom>
                        </rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                    </swrl:AtomList>
                </rdf:rest>
            </swrl:AtomList>
        </swrl:body>
        <swrl:head>
            <swrl:AtomList>
                <rdf:first>
                    <swrl:ClassAtom>
                        <swrl:classPredicate rdf:resource="#Masakan_Berisiko"/>
                        <swrl:argument1 rdf:resource="urn:swrl#masakan"/>
                    </swrl:ClassAtom>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </swrl:AtomList>
        </swrl:head>
    </swrl:Imp>

    <!-- RULE 12.4.3c : Masakan_Berenergi_Tinggi (perhitungan bertahap) -->
    <swrl:Imp rdf:about="#Rule_12_4_3c_BerenergiTinggi">
        <rdfs:label>12.4.3 Masakan Berenergi Tinggi</rdfs:label>
        <swrl:body>
            <swrl:AtomList>
                <rdf:first>
                    <swrl:DatavaluedPropertyAtom>
                        <swrl:propertyPredicate rdf:resource="#punyaKomposisiKarbohidrat"/>
                        <swrl:argument1 rdf:resource="urn:swrl#masakan"/>
                        <swrl:argument2 rdf:resource="urn:swrl#karbo"/>
                    </swrl:DatavaluedPropertyAtom>
                </rdf:first>
                <rdf:rest>
                    <swrl:AtomList>
                        <rdf:first>
                            <swrl:DatavaluedPropertyAtom>
                                <swrl:propertyPredicate rdf:resource="#punyaKomposisiProtein"/>
                                <swrl:argument1 rdf:resource="urn:swrl#masakan"/>
                                <swrl:argument2 rdf:resource="urn:swrl#protein"/>
                            </swrl:DatavaluedPropertyAtom>
                        </rdf:first>
                        <rdf:rest>
                            <swrl:AtomList>
                                <rdf:first>
                                    <swrl:BuiltinAtom>
                                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#add"/>
                                        <swrl:arguments>
                                            <rdf:List>
                                                <rdf:first rdf:resource="urn:swrl#jumlah"/>
                                                <rdf:rest>
                                                    <rdf:List>
                                                        <rdf:first rdf:resource="urn:swrl#karbo"/>
                                                        <rdf:rest>
                                                            <rdf:List>
                                                                <rdf:first rdf:resource="urn:swrl#protein"/>
                                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                            </rdf:List>
                                                        </rdf:rest>
                                                    </rdf:List>
                                                </rdf:rest>
                                            </rdf:List>
                                        </swrl:arguments>
                                    </swrl:BuiltinAtom>
                                </rdf:first>
                                <rdf:rest>
                                    <swrl:AtomList>
                                        <rdf:first>
                                            <swrl:BuiltinAtom>
                                                <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#multiply"/>
                                                <swrl:arguments>
                                                    <rdf:List>
                                                        <rdf:first rdf:resource="urn:swrl#totalKalori"/>
                                                        <rdf:rest>
                                                            <rdf:List>
                                                                <rdf:first rdf:resource="urn:swrl#jumlah"/>
                                                                <rdf:rest>
                                                                    <rdf:List>
                                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4</rdf:first>
                                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                    </rdf:List>
                                                                </rdf:rest>
                                                            </rdf:List>
                                                        </rdf:rest>
                                                    </rdf:List>
                                                </swrl:arguments>
                                            </swrl:BuiltinAtom>
                                        </rdf:first>
                                        <rdf:rest>
                                            <swrl:AtomList>
                                                <rdf:first>
                                                    <swrl:BuiltinAtom>
                                                        <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThan"/>
                                                        <swrl:arguments>
                                                            <rdf:List>
                                                                <rdf:first rdf:resource="urn:swrl#totalKalori"/>
                                                                <rdf:rest>
                                                                    <rdf:List>
                                                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">300</rdf:first>
                                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                    </rdf:List>
                                                                </rdf:rest>
                                                            </rdf:List>
                                                        </swrl:arguments>
                                                    </swrl:BuiltinAtom>
                                                </rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </swrl:AtomList>
                                        </rdf:rest>
                                    </swrl:AtomList>
                                </rdf:rest>
                            </swrl:AtomList>
                        </rdf:rest>
                    </swrl:AtomList>
                </rdf:rest>
            </swrl:AtomList>
        </swrl:body>
        <swrl:head>
            <swrl:AtomList>
                <rdf:first>
                    <swrl:ClassAtom>
                        <swrl:classPredicate rdf:resource="#Masakan_Berenergi_Tinggi"/>
                        <swrl:argument1 rdf:resource="urn:swrl#masakan"/>
                    </swrl:ClassAtom>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </swrl:AtomList>
        </swrl:head>
    </swrl:Imp>

    <!-- RULE 12.4.4a : Masakan_Sunda_Pedas -->
    <swrl:Imp rdf:about="#Rule_12_4_4a_SundaPedas">
        <rdfs:label>12.4.4 Masakan Sunda Pedas</rdfs:label>
        <swrl:body>
            <swrl:AtomList>
                <rdf:first>
                    <swrl:IndividualPropertyAtom>
                        <swrl:propertyPredicate rdf:resource="#berasalDari"/>
                        <swrl:argument1 rdf:resource="urn:swrl#masakan"/>
                        <swrl:argument2 rdf:resource="#sunda"/>
                    </swrl:IndividualPropertyAtom>
                </rdf:first>
                <rdf:rest>
                    <swrl:AtomList>
                        <rdf:first>
                            <swrl:IndividualPropertyAtom>
                                <swrl:propertyPredicate rdf:resource="#punyaRasa"/>
                                <swrl:argument1 rdf:resource="urn:swrl#masakan"/>
                                <swrl:argument2 rdf:resource="#pedas"/>
                            </swrl:IndividualPropertyAtom>
                        </rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                    </swrl:AtomList>
                </rdf:rest>
            </swrl:AtomList>
        </swrl:body>
        <swrl:head>
            <swrl:AtomList>
                <rdf:first>
                    <swrl:ClassAtom>
                        <swrl:classPredicate rdf:resource="#Masakan_Sunda_Pedas"/>
                        <swrl:argument1 rdf:resource="urn:swrl#masakan"/>
                    </swrl:ClassAtom>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </swrl:AtomList>
        </swrl:head>
    </swrl:Imp>

    <!-- RULE 12.4.4c : Sambal_Khas_Sumatera_Utara -->
    <swrl:Imp rdf:about="#Rule_12_4_4c_SambalSumut">
        <rdfs:label>12.4.4 Sambal Khas Sumatera Utara</rdfs:label>
        <swrl:body>
            <swrl:AtomList>
                <rdf:first>
                    <swrl:ClassAtom>
                        <swrl:classPredicate rdf:resource="#Sambal"/>
                        <swrl:argument1 rdf:resource="urn:swrl#sambal"/>
                    </swrl:ClassAtom>
                </rdf:first>
                <rdf:rest>
                    <swrl:AtomList>
                        <rdf:first>
                            <swrl:IndividualPropertyAtom>
                                <swrl:propertyPredicate rdf:resource="#berasalDari"/>
                                <swrl:argument1 rdf:resource="urn:swrl#sambal"/>
                                <swrl:argument2 rdf:resource="#sumatera_utara"/>
                            </swrl:IndividualPropertyAtom>
                        </rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                    </swrl:AtomList>
                </rdf:rest>
            </swrl:AtomList>
        </swrl:body>
        <swrl:head>
            <swrl:AtomList>
                <rdf:first>
                    <swrl:ClassAtom>
                        <swrl:classPredicate rdf:resource="#Sambal_Khas_Sumatera_Utara"/>
                        <swrl:argument1 rdf:resource="urn:swrl#sambal"/>
                    </swrl:ClassAtom>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </swrl:AtomList>
        </swrl:head>
    </swrl:Imp>

    <!-- RULE 12.4.5 : Perlu_Diperiksa (validasi lemak < 0) -->
    <swrl:Imp rdf:about="#Rule_12_4_5_Validasi">
        <rdfs:label>12.4.5 Perlu Diperiksa</rdfs:label>
        <swrl:body>
            <swrl:AtomList>
                <rdf:first>
                    <swrl:DatavaluedPropertyAtom>
                        <swrl:propertyPredicate rdf:resource="#punyaKomposisiLemak"/>
                        <swrl:argument1 rdf:resource="urn:swrl#masakan"/>
                        <swrl:argument2 rdf:resource="urn:swrl#lemak"/>
                    </swrl:DatavaluedPropertyAtom>
                </rdf:first>
                <rdf:rest>
                    <swrl:AtomList>
                        <rdf:first>
                            <swrl:BuiltinAtom>
                                <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#lessThan"/>
                                <swrl:arguments>
                                    <rdf:List>
                                        <rdf:first rdf:resource="urn:swrl#lemak"/>
                                        <rdf:rest>
                                            <rdf:List>
                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:List>
                                        </rdf:rest>
                                    </rdf:List>
                                </swrl:arguments>
                            </swrl:BuiltinAtom>
                        </rdf:first>
                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                    </swrl:AtomList>
                </rdf:rest>
            </swrl:AtomList>
        </swrl:body>
        <swrl:head>
            <swrl:AtomList>
                <rdf:first>
                    <swrl:ClassAtom>
                        <swrl:classPredicate rdf:resource="#Perlu_Diperiksa"/>
                        <swrl:argument1 rdf:resource="urn:swrl#masakan"/>
                    </swrl:ClassAtom>
                </rdf:first>
                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </swrl:AtomList>
        </swrl:head>
    </swrl:Imp>

</rdf:RDF>
